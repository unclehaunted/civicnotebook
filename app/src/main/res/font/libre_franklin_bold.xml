<?xml version="1.0" encoding="utf-8"?>
<!-- Libre Franklin é uma fonte variável (eixo wght 100-900): o negrito real é o mesmo ficheiro com wght 700. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/libre_franklin"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700"
        app:font="@font/libre_franklin"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:fontVariationSettings="'wght' 700" />
</font-family>
