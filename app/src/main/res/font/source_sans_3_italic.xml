<?xml version="1.0" encoding="utf-8"?>
<!-- Source Sans Italic: instância wght 400 da fonte variável (a instância por omissão é a mais leve). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/source_sans_italic_vf"
        android:fontStyle="italic"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"
        app:font="@font/source_sans_italic_vf"
        app:fontStyle="italic"
        app:fontWeight="400"
        app:fontVariationSettings="'wght' 400" />
</font-family>
