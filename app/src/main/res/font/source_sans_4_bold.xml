<?xml version="1.0" encoding="utf-8"?>
<!-- Source Sans Bold: instância wght 700 da fonte variável (a instância por omissão é a mais leve). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/source_sans_vf"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700"
        app:font="@font/source_sans_vf"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:fontVariationSettings="'wght' 700" />
</font-family>
